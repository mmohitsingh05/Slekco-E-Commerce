# Backend environment variables — copy to .env and fill in
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (never commit the real one)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/slekco?retryWrites=true&w=majority

# Comma-separated allowed origins for CORS
CLIENT_ORIGINS=http://localhost:3000,https://your-app.vercel.app